<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="4.0"/>

  <template class="OverviewPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <property name="halign">center</property>
    <property name="valign">center</property>
    <property name="margin-top">36</property>
    <property name="margin-bottom">36</property>
    <property name="margin-start">48</property>
    <property name="margin-end">48</property>

    <child>
      <object class="GtkLabel" id="overview_title">
        <property name="label">&lt;b&gt;Overview&lt;/b&gt;</property>
        <property name="use-markup">true</property>
        <property name="halign">center</property>
      </object>
    </child>

    <child>
      <object class="GtkBox" id="overview_stats_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="halign">center</property>
        <property name="valign">center</property>

        <child>
          <object class="GtkBox" id="overview_total_row">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Total apps:</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="total_value"/>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="overview_running_row">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Running:</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="running_value">
                <property name="use-markup">true</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="overview_stopped_row">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Stopped:</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="stopped_value">
                <property name="use-markup">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>
