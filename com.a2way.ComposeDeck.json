{
  "app-id": "com.a2way.ComposeDeck",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "composedeck",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=x11",
    "--socket=session-bus",
    "--share=ipc",
    "--filesystem=home",
    "--filesystem=xdg-run/podman",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/debug",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "/share/vala"
  ],
  "modules": [
    {
      "name": "composedeck",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "echo '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' > compose-deck.gresource.xml",
        "echo '<gresources>' >> compose-deck.gresource.xml",
        "echo '  <gresource prefix=\"/com/a2way/ComposeDeck\">' >> compose-deck.gresource.xml",
        "for f in *.ui; do echo \"    <file>$f</file>\" >> compose-deck.gresource.xml; done",
        "echo '  </gresource>' >> compose-deck.gresource.xml",
        "echo '</gresources>' >> compose-deck.gresource.xml",
        "valac --pkg gtk4 --pkg gio-2.0 --pkg gio-unix-2.0 --pkg libadwaita-1 --pkg json-glib-1.0 --gresources=compose-deck.gresource.xml --gresourcesdir=. *.vala -o /app/bin/composedeck"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "dest": ".",
          "skip": [".git", "build", "repo", ".flatpak-builder", "*.flatpak"]
        }
      ]
    }
  ]
}