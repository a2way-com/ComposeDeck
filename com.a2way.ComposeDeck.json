{
  "app-id": "com.a2way.ComposeDeck",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "composedeck",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=xdg-run/podman:create",
    "--filesystem=/run/podman/podman.sock",
    "--filesystem=xdg-run/docker.sock",
    "--filesystem=/run/docker.sock",
    "--talk-name=org.freedesktop.systemd1",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "/share/vala"
  ],
  "modules": [
    {
      "name": "composedeck",
      "buildsystem": "simple",
      "build-commands": [
        "sh build.sh"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "dest": ".",
          "skip": [
            ".git",
            ".github",
            "build",
            "repo",
            ".flatpak-builder",
            "packaging",
            "*.flatpak"
          ]
        }
      ]
    }
  ]
}
