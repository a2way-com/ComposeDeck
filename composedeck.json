{
  "app-id": "com.a2way.ComposeDeck",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "composedeck",
  "finish-args": [
    "--share=network",
    "--filesystem=home",
    "--filesystem=xdg-run/podman",
    "--socket=wayland"
  ],
  "build-options": {
    "env": {
      "VALAFLAGS": "--pkg gtk4 --pkg gio-2.0"
    }
  },
  "modules": [
    {
      "name": "composedeck",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp docker-compose /app/bin/docker-compose",
        "valac --pkg gtk4 --pkg gio-2.0 composedeck.vala -o /app/bin/composedeck"
      ],
      "sources": [
        {
          "type": "file",
          "path": "composedeck.vala"
        },
        {
          "type": "file",
          "path": "docker-compose"
        }
      ]
    }
  ]
}
