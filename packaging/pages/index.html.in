<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ComposeDeck</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f5f4;
      --fg: #241f31;
      --muted: #5e5c64;
      --card: #ffffff;
      --accent: #1c71d8;
      --border: rgba(0, 0, 0, .1);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #1d1d20;
        --fg: #f6f5f4;
        --muted: #c0bfbc;
        --card: #2d2d31;
        --accent: #78aeed;
        --border: rgba(255, 255, 255, .12);
      }
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.6;
    }

    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 64px 24px;
    }

    header {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 32px;
    }

    header img {
      width: 80px;
      height: 80px;
    }

    h1 {
      margin: 0;
      font-size: 2rem;
    }

    .version {
      color: var(--muted);
      font-size: .95rem;
    }

    p, ul {
      color: var(--muted);
    }

    h2 {
      margin-top: 40px;
      font-size: 1.2rem;
    }

    code, pre {
      font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    }

    pre {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      overflow-x: auto;
    }

    code { font-size: .92em; }

    a { color: var(--accent); }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 24px 0;
    }

    .button {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 999px;
      background: var(--accent);
      color: white;
      text-decoration: none;
      font-weight: 600;
    }

    .button.secondary {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--border);
    }

    footer {
      margin-top: 48px;
      color: var(--muted);
      font-size: .9rem;
    }
  </style>
</head>
<body>
  <main>
    <header>
      <img src="__BASE_URL__/com.a2way.ComposeDeck.svg" alt="ComposeDeck icon">
      <div>
        <h1>ComposeDeck</h1>
        <div class="version">Version __VERSION__</div>
      </div>
    </header>

    <p>Manage Docker Compose projects running on Podman from a native GTK desktop app.</p>

    <div class="actions">
      <a class="button" href="com.a2way.ComposeDeck.flatpakref">Install with Flatpak</a>
      <a class="button secondary" href="__REPO_URL__">View source</a>
    </div>

    <h2>Install from the terminal</h2>
    <pre><code>flatpak install --user --from __BASE_URL__/com.a2way.ComposeDeck.flatpakref</code></pre>
    <p>Updates are delivered through <code>flatpak update</code>.</p>

    <h2>Requirements</h2>
    <ul>
      <li>Flatpak, with the Flathub remote available for the GNOME runtime.</li>
      <li>Podman, with the Docker-compatible socket enabled:<br>
        <code>systemctl --user enable --now podman.socket</code></li>
      <li>Your Compose projects in <code>~/Apps</code>, or another folder chosen in Settings.</li>
    </ul>

    <footer>
      <a href="__REPO_URL__">ComposeDeck</a> · MIT licensed
    </footer>
  </main>
</body>
</html>
