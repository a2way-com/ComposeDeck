using Gtk 4.0;
using Adw 1;

template $AppDetailsPage: Gtk.Box {
  orientation: vertical;
  spacing: 12;
  margin-top: 36;
  margin-bottom: 36;
  margin-start: 48;
  margin-end: 48;
  halign: fill;
  hexpand: true;
  valign: start;
  visible: false;

  Adw.PreferencesGroup {

    Adw.ActionRow pathRow {
      title: "Path";

      Gtk.Button openButton {
        label: "Open dir...";
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
      }

      Gtk.Button pathCopyButton {
        label: "Copy";
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
      }

      Gtk.Button composeButton {
        label: "Compose file";
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
      }
    }

    Adw.ActionRow statusRow {
      title: "Status";
      use-markup: true;

      Gtk.Label refreshedLabel {
        css-classes: ["caption", "dim-label"];
        valign: center;
      }
    }

    Adw.ActionRow actionsRow {
      title: "Actions";

      Gtk.Box {
        orientation: horizontal;
        spacing: 6;
        halign: end;
        valign: center;

        Gtk.Button startButton {
          label: "Start";
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
        }

        Gtk.Button stopButton {
          label: "Stop";
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
        }

        Gtk.Button restartButton {
          label: "Restart";
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
        }

        Adw.Spinner actionSpinner {
          hexpand: false;
          halign: end;
          valign: center;
          width-request: 20;
          height-request: 20;
          margin-top: 6;
          margin-bottom: 6;
          visible: false;
        }
      }
    }
  }

  Gtk.Label servicesHeading {
    label: "Services";
    halign: start;
    hexpand: true;
    margin-top: 12;
    margin-bottom: 6;
    css-classes: ["title"];
  }

  Gtk.Box servicesBox {
    orientation: vertical;
    spacing: 12;
    hexpand: true;
    halign: fill;
    valign: start;
  }
}
