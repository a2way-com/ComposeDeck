using Gtk 4.0;
using Adw 1;

template $AppDetailsPage: Gtk.Box {
  orientation: vertical;
  spacing: 12;
  margin-top: 36;
  margin-bottom: 36;
  margin-start: 48;
  margin-end: 48;
  halign: fill;
  hexpand: true;
  valign: start;
  visible: false;

  Adw.PreferencesGroup {

    Adw.ActionRow pathRow {
      title: "Path";

      Gtk.Button openButton {
        label: "Open dir...";
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
      }

      Gtk.Button pathCopyButton {
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
        child: Gtk.Image {
          icon-name: "edit-copy-symbolic";
          pixel-size: 16;
        };
      }

      Gtk.Button composeButton {
        label: "Compose file";
        hexpand: false;
        halign: end;
        valign: center;
        css-classes: ["flat"];
        margin-top: 6;
        margin-bottom: 6;
      }
    }

    Adw.ActionRow envRow {
      title: "Environment";
      activatable: true;

      Gtk.Label envSummary {
        css-classes: ["dim-label"];
        valign: center;
        ellipsize: end;
      }

      Gtk.Image {
        icon-name: "go-next-symbolic";
        valign: center;
        css-classes: ["dim-label"];
      }
    }

    Adw.ActionRow projectRow {
      title: "Project";
      visible: false;
    }

    Adw.ActionRow statusRow {
      title: "Status";
      use-markup: true;

      Gtk.Label refreshedLabel {
        css-classes: ["caption", "dim-label"];
        valign: center;
      }
    }

    Adw.ActionRow actionsRow {
      title: "Actions";

      Gtk.Box {
        orientation: horizontal;
        spacing: 6;
        halign: end;
        valign: center;

        Gtk.Button startButton {
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
          child: Gtk.Box {
            orientation: horizontal;
            spacing: 6;
            halign: center;
            valign: center;
            Gtk.Image {
              icon-name: "media-playback-start-symbolic";
              pixel-size: 16;
            }
            Gtk.Label {
              label: "Start";
            }
          };
        }

        Gtk.Button stopButton {
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
          child: Gtk.Box {
            orientation: horizontal;
            spacing: 6;
            halign: center;
            valign: center;
            Gtk.Image {
              icon-name: "media-playback-stop-symbolic";
              pixel-size: 16;
            }
            Gtk.Label {
              label: "Stop";
            }
          };
        }

        Gtk.Button restartButton {
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
          child: Gtk.Box {
            orientation: horizontal;
            spacing: 6;
            halign: center;
            valign: center;
            Gtk.Image {
              icon-name: "view-refresh-symbolic";
              pixel-size: 16;
            }
            Gtk.Label {
              label: "Restart";
            }
          };
        }

        Gtk.Button orphanButton {
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          tooltip-text: "Remove containers that are not in the compose file";
          margin-top: 6;
          margin-bottom: 6;
          child: Gtk.Box {
            orientation: horizontal;
            spacing: 6;
            halign: center;
            valign: center;
            Gtk.Image {
              icon-name: "user-trash-symbolic";
              pixel-size: 16;
            }
            Gtk.Label {
              label: "Remove orphans";
            }
          };
        }

        Adw.Spinner actionSpinner {
          hexpand: false;
          halign: end;
          valign: center;
          width-request: 20;
          height-request: 20;
          margin-top: 6;
          margin-bottom: 6;
          visible: false;
        }
      }
    }
  }

  Gtk.Label shortcutsHeading {
    label: "Shortcuts";
    halign: start;
    hexpand: true;
    margin-top: 12;
    margin-bottom: 6;
    css-classes: ["title"];
    visible: false;
  }

  Adw.PreferencesGroup shortcutsGroup {
    visible: false;
  }

  Gtk.Label servicesHeading {
    label: "Services";
    halign: start;
    hexpand: true;
    margin-top: 12;
    margin-bottom: 6;
    css-classes: ["title"];
  }

  Gtk.Box servicesBox {
    orientation: vertical;
    spacing: 12;
    hexpand: true;
    halign: fill;
    valign: start;

    Adw.PreferencesGroup engineBanner {
      visible: false;

      Adw.ActionRow {
        title: "No container engine is reachable";
        subtitle: "ComposeDeck cannot query Podman or Docker container state.";

        Gtk.Button retryButton {
          label: "Retry";
          hexpand: false;
          valign: center;
          css-classes: ["flat"];
          margin-top: 6;
          margin-bottom: 6;
        }
      }
    }
  }
}
