using Gtk 4.0;

template $AppRow: Gtk.ListBoxRow {
  Gtk.Box {
    orientation: horizontal;
    spacing: 12;
    margin-start: 14;
    margin-end: 14;
    margin-top: 8;
    margin-bottom: 8;
    hexpand: true;
    valign: center;

    Gtk.Label indicator {
      valign: center;
      use-markup: true;
    }

    Gtk.Label nameLabel {
      halign: start;
      hexpand: true;
      valign: center;
      xalign: 0;
    }
  }
}
