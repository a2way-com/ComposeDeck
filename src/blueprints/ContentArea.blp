using Gtk 4.0;
using Adw 1;

template $ContentArea: Gtk.Box {
  orientation: vertical;

  Adw.HeaderBar {
    show-start-title-buttons: false;
    css-classes: ["flat"];
    title-widget: Adw.WindowTitle contentTitle {
      title: "ComposeDeck";
    };
  }

  Gtk.ScrolledWindow {
    hexpand: true;
    vexpand: true;
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    overlay-scrolling: false;

    child: Gtk.Box contentBox {
      orientation: vertical;
      hexpand: true;
      vexpand: true;
    };
  }
}
