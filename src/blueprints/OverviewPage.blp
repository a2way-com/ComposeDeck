using Gtk 4.0;
using Adw 1;

template $OverviewPage: Gtk.Box {
  orientation: vertical;
  spacing: 12;
  margin-top: 24;
  margin-bottom: 24;
  margin-start: 24;
  margin-end: 24;
  halign: center;
  hexpand: true;
  valign: start;

  Adw.Banner engineBanner {
    title: "No container engine is reachable";
    button-label: "Retry";
    revealed: false;
  }

  Gtk.Box statsBox {
    orientation: horizontal;
    spacing: 24;
    halign: center;
    valign: start;
    margin-bottom: 12;

    Gtk.Box {
      orientation: vertical;
      spacing: 2;
      halign: center;

      Gtk.Label {
        label: "Total";
        css-classes: ["caption", "dim-label"];
      }

      Gtk.Label totalValue {
        css-classes: ["title-1"];
      }
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 2;
      halign: center;

      Gtk.Label {
        label: "Running";
        css-classes: ["caption", "dim-label"];
      }

      Gtk.Label runningValue {
        css-classes: ["title-1"];
        use-markup: true;
      }
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 2;
      halign: center;

      Gtk.Label {
        label: "Stopped";
        css-classes: ["caption", "dim-label"];
      }

      Gtk.Label stoppedValue {
        css-classes: ["title-1"];
        use-markup: true;
      }
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 2;
      halign: center;

      Gtk.Label {
        label: "Partial";
        css-classes: ["caption", "dim-label"];
      }

      Gtk.Label partialValue {
        css-classes: ["title-1"];
        use-markup: true;
      }
    }
  }

  Gtk.Box bulkBox {
    orientation: horizontal;
    spacing: 6;
    halign: center;
    valign: start;
    margin-bottom: 12;

    Gtk.Button startAllButton {
      label: "Start all";
      hexpand: false;
      valign: center;
      css-classes: ["flat"];
    }

    Gtk.Button stopAllButton {
      label: "Stop all";
      hexpand: false;
      valign: center;
      css-classes: ["flat"];
    }

    Gtk.Button restartAllButton {
      label: "Restart all";
      hexpand: false;
      valign: center;
      css-classes: ["flat"];
    }

    Adw.Spinner bulkSpinner {
      hexpand: false;
      valign: center;
      width-request: 20;
      height-request: 20;
      visible: false;
    }
  }

  Gtk.Box freshnessBox {
    orientation: horizontal;
    spacing: 6;
    halign: center;
    margin-bottom: 6;

    Gtk.Label updatedLabel {
      css-classes: ["caption", "dim-label"];
    }

    Gtk.Button refreshButton {
      hexpand: false;
      valign: center;
      css-classes: ["flat"];
      tooltip-text: "Refresh now";
      child: Gtk.Image {
        icon-name: "view-refresh-symbolic";
        pixel-size: 14;
      };
    }
  }

  Gtk.Box filterBox {
    orientation: horizontal;
    spacing: 6;
    halign: center;
    margin-bottom: 12;

    Gtk.ToggleButton allFilter {
      label: "All";
      active: true;
      css-classes: ["pill"];
    }

    Gtk.ToggleButton runningFilter {
      label: "Running";
      group: allFilter;
      css-classes: ["pill"];
    }

    Gtk.ToggleButton partialFilter {
      label: "Partial";
      group: allFilter;
      css-classes: ["pill"];
    }

    Gtk.ToggleButton stoppedFilter {
      label: "Stopped";
      group: allFilter;
      css-classes: ["pill"];
    }

    Gtk.ToggleButton pinnedFilter {
      label: "Pinned";
      group: allFilter;
      css-classes: ["pill"];
    }
  }

  Gtk.Stack contentStack {
    hexpand: true;
    vexpand: true;

    Gtk.FlowBox flowBox {
      halign: center;
      hexpand: true;
      valign: start;
      column-spacing: 16;
      row-spacing: 16;
      min-children-per-line: 1;
      max-children-per-line: 4;
      selection-mode: none;
      margin-top: 8;
    }

    Gtk.Box emptyState {
      orientation: vertical;
      spacing: 8;
      halign: center;
      valign: center;
      hexpand: true;
      vexpand: true;

      Gtk.Image {
        icon-name: "folder-open-symbolic";
        pixel-size: 48;
        opacity: 0.5;
      }

      Gtk.Label emptyTitle {
        label: "No apps found";
        css-classes: ["title-2"];
        opacity: 0.7;
      }

      Gtk.Label emptyHint {
        label: "Add compose projects to your apps folder,\nor change it in Settings (hamburger menu).";
        css-classes: ["dim-label"];
        justify: center;
      }
    }
  }
}