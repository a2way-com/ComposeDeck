using Gtk 4.0;

template $OverviewPage: Gtk.Box {
  orientation: vertical;
  spacing: 12;
  halign: center;
  valign: center;
  margin-top: 36;
  margin-bottom: 36;
  margin-start: 48;
  margin-end: 48;

  Gtk.Box overviewStatsBox {
    orientation: vertical;
    spacing: 6;
    halign: center;
    valign: center;

    Gtk.Box overviewTotalRow {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      Gtk.Label {
        label: "Total apps:";
      }

      Gtk.Label totalValue {
        use-markup: true;
      }
    }

    Gtk.Box overviewRunningRow {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      Gtk.Label {
        label: "Running:";
      }

      Gtk.Label runningValue {
        use-markup: true;
      }
    }

    Gtk.Box overviewStoppedRow {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      Gtk.Label {
        label: "Stopped:";
      }

      Gtk.Label stoppedValue {
        use-markup: true;
      }
    }
  }
}
