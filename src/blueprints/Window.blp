using Gtk 4.0;
using Adw 1;

template $Window: Adw.ApplicationWindow {
  default-width: 1000;
  default-height: 700;
  title: "ComposeDeck";

  content: Adw.ToastOverlay {
    child: Adw.NavigationSplitView splitView {
      min-sidebar-width: 240;
      max-sidebar-width: 320;

      sidebar: Adw.NavigationPage sidebarPage {
        title: "ComposeDeck";
        child: Gtk.Box sidebarBox {
          orientation: vertical;
          hexpand: true;
          vexpand: true;
        };
      };

      content: Adw.NavigationPage contentPage {
        title: "Content";
        child: Gtk.Box contentBox {
          orientation: vertical;
          hexpand: true;
          vexpand: true;
        };
      };
    };
  };
}
